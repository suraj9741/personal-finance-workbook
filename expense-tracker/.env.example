# Copy to .env and change the password: cp .env.example .env
# Nothing here is a real secret; .env is gitignored.

POSTGRES_USER=expense
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=expense

# Ports on your Mac. Both bind to 127.0.0.1, so nothing on your Wi-Fi can reach them.
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Backend settings
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
SESSION_TTL_DAYS=30
# false while it runs on http://localhost. Set true once it is served over HTTPS.
COOKIE_SECURE=false
# Used to build invite and password-reset links.
PUBLIC_BASE_URL=http://localhost:8080
# Only needed for `npm run dev` on 5173; the nginx front end is same-origin.
CORS_ORIGINS=http://localhost:5173

# Backups in ./backups (scripts/backup.sh, run daily by make backup-schedule).
# How many to keep, on this Mac and in Google Drive. Daily and manual dumps are counted separately.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_MANUAL=3
# rclone remote for the encrypted Drive copy (make backup-drive-setup creates it). "none" turns it off.
BACKUP_REMOTE=expense-drive-crypt:

# Servers only (docker-compose.deploy.yml pulls the images CI pushes; the Mac leaves these unset).
# COMPOSE_FILE=docker-compose.deploy.yml
# IMAGE_NAMESPACE=<dockerhub-user>
# IMAGE_TAG=latest          # or sha-<commit> to pin one build
