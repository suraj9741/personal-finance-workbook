<mxfile host="drawio" type="device"><diagram id="production-architecture" name="Production architecture"><mxGraphModel dx="1800" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="960" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Expense tracker: production architecture" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#1F2328;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="28" as="geometry"/></mxCell><mxCell id="subtitle" value="How the app runs on one DigitalOcean droplet, how a change gets there, and where the backups go. Values in &amp;lt;angle brackets&amp;gt; are placeholders: no hostnames, IPs or secrets in the repository." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#57606A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="18" as="geometry"/></mxCell><mxCell id="dns" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;DuckDNS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;lt;name&amp;gt;.duckdns.org (free)&lt;br&gt;A record → the droplet&amp;#x27;s IP&lt;br&gt;set once by hand" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="250" height="86" as="geometry"/></mxCell><mxCell id="dns-icon-globe" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="dns"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;Browser&lt;/font&gt;&lt;/b&gt;&lt;br&gt;laptop or phone&lt;br&gt;https://&amp;lt;name&amp;gt;.duckdns.org&lt;br&gt;HttpOnly, Secure cookie" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="250" height="86" as="geometry"/></mxCell><mxCell id="browser-icon-browser" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iIzFGNkZFQiIgZD0iTTIwIDRINGMtMS4xIDAtMS45OS45LTEuOTkgMkwyIDE4YzAgMS4xLjkgMiAyIDJoMTZjMS4xIDAgMi0uOSAyLTJWNmMwLTEuMS0uOS0yLTItMnptLTUgMTRINHYtNGgxMXY0em0wLTVINFY5aDExdjR6bTUgNWgtNFY5aDR2OXoiLz48L3N2Zz4=;" vertex="1" parent="browser"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="le" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;Let&amp;#x27;s Encrypt&lt;/font&gt;&lt;/b&gt;&lt;br&gt;free TLS certificate&lt;br&gt;Caddy asks for and renews it&lt;br&gt;checks the name on :80/:443" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="250" height="86" as="geometry"/></mxCell><mxCell id="le-icon-letsencrypt" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="le"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="legend-box" value="" style="rounded=1;arcSize=6;absoluteArcSize=1;html=1;fillColor=#FFFFFF;strokeColor=#D0D7DE;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="250" height="190" as="geometry"/></mxCell><mxCell id="legend-title" value="Lines" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#1F2328;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="54" y="522" width="200" height="18" as="geometry"/></mxCell><mxCell id="legend-line-0" style="endArrow=block;endFill=1;endSize=6;html=1;strokeColor=#1F6FEB;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="556" as="sourcePoint"/><mxPoint x="94" y="556" as="targetPoint"/></mxGeometry></mxCell><mxCell id="legend-0" value="a request from the browser" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#57606A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="104" y="547" width="165" height="18" as="geometry"/></mxCell><mxCell id="legend-line-1" style="endArrow=block;endFill=1;endSize=6;html=1;strokeColor=#8250DF;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="584" as="sourcePoint"/><mxPoint x="94" y="584" as="targetPoint"/></mxGeometry></mxCell><mxCell id="legend-1" value="a deploy from GitHub" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#57606A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="104" y="575" width="165" height="18" as="geometry"/></mxCell><mxCell id="legend-line-2" style="endArrow=block;endFill=1;endSize=6;html=1;strokeColor=#BC4C00;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="612" as="sourcePoint"/><mxPoint x="94" y="612" as="targetPoint"/></mxGeometry></mxCell><mxCell id="legend-2" value="images: build, push, pull" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#57606A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="104" y="603" width="165" height="18" as="geometry"/></mxCell><mxCell id="legend-line-3" style="endArrow=block;endFill=1;endSize=6;html=1;strokeColor=#1A7F37;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="640" as="sourcePoint"/><mxPoint x="94" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="legend-3" value="backups" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#57606A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="104" y="631" width="165" height="18" as="geometry"/></mxCell><mxCell id="legend-line-4" style="endArrow=block;endFill=1;endSize=6;html=1;strokeColor=#6E7781;strokeWidth=2;dashed=1;dashPattern=7 5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="54" y="668" as="sourcePoint"/><mxPoint x="94" y="668" as="targetPoint"/></mxGeometry></mxCell><mxCell id="legend-4" value="DNS, certificate, one-shot jobs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#57606A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="104" y="659" width="165" height="18" as="geometry"/></mxCell><mxCell id="firewall" value="DigitalOcean cloud firewall · inbound 22, 80, 443 only" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;horizontal=0;align=left;spacingLeft=36;fontSize=12;fontStyle=1;fontColor=#CF222E;fillColor=#FFEBE9;strokeColor=#CF222E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="26" height="620" as="geometry"/></mxCell><mxCell id="droplet" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#1F2328&quot;&gt;DigitalOcean droplet&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ubuntu x86-64 · 1 vCPU · 512 MB RAM + 2 GB swap · key-only SSH, fail2ban · Docker Engine" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=50;spacingTop=4;fontSize=12;fontColor=#57606A;fillColor=#F0F7FF;strokeColor=#0080FF;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="110" width="890" height="620" as="geometry"/></mxCell><mxCell id="droplet-icon-digitalocean" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="droplet"><mxGeometry x="14" y="12" width="30" height="30" as="geometry"/></mxCell><mxCell id="compose" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#1F2328&quot;&gt;Docker Compose · project expense-tracker&lt;/font&gt;&lt;/b&gt;&lt;br&gt;docker-compose.deploy.yml + .env · pulls the images, never builds" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=50;spacingTop=4;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#2496ED;strokeWidth=1.6;fontFamily=Helvetica;dashed=1;dashPattern=8 5;" vertex="1" parent="droplet"><mxGeometry x="16" y="66" width="560" height="504" as="geometry"/></mxCell><mxCell id="compose-icon-docker" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="compose"><mxGeometry x="14" y="12" width="30" height="30" as="geometry"/></mxCell><mxCell id="caddy" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;caddy&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Caddy 2.10 · publishes :80 and :443&lt;br&gt;gets and renews the certificate&lt;br&gt;redirects http:// to https://" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="compose"><mxGeometry x="16" y="64" width="320" height="86" as="geometry"/></mxCell><mxCell id="caddy-icon-caddy" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="caddy"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="frontend" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;frontend&lt;/font&gt;&lt;/b&gt;&lt;br&gt;nginx serving the React + Vite build&lt;br&gt;on 127.0.0.1:8080, never public&lt;br&gt;proxies /api/ to backend:8000" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="compose"><mxGeometry x="16" y="176" width="320" height="86" as="geometry"/></mxCell><mxCell id="frontend-icon-nginx" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="frontend"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="frontend-icon-vite" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="frontend"><mxGeometry x="290" y="10" width="20" height="20" as="geometry"/></mxCell><mxCell id="frontend-icon-react" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="frontend"><mxGeometry x="264" y="10" width="20" height="20" as="geometry"/></mxCell><mxCell id="backend" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;backend&lt;/font&gt;&lt;/b&gt;&lt;br&gt;FastAPI · Python 3.12 · SQLAlchemy 2&lt;br&gt;/api/v1, /healthz, /readyz, /metrics&lt;br&gt;not published on the host" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="compose"><mxGeometry x="16" y="288" width="320" height="86" as="geometry"/></mxCell><mxCell id="backend-icon-fastapi" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="backend"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;db&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Postgres 16 (alpine), not published&lt;br&gt;shared_buffers 48 MB, 30 connections&lt;br&gt;all data in the pgdata volume" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="compose"><mxGeometry x="16" y="400" width="320" height="86" as="geometry"/></mxCell><mxCell id="db-icon-postgresql" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="db"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="mem" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;Memory limits&lt;/font&gt;&lt;/b&gt;&lt;br&gt;caddy  64 MB&lt;br&gt;frontend  64 MB&lt;br&gt;backend  320 MB&lt;br&gt;migrate, seed  320 MB&lt;br&gt;db  256 MB&lt;br&gt;logs  10 MB × 3 each&lt;br&gt;restart: unless-stopped" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFF8C5;strokeColor=#D4A72C;fontFamily=Helvetica;" vertex="1" parent="compose"><mxGeometry x="356" y="64" width="188" height="198" as="geometry"/></mxCell><mxCell id="migrate" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;migrate → seed&lt;/font&gt;&lt;/b&gt;&lt;br&gt;one-shot, before backend&lt;br&gt;alembic upgrade head&lt;br&gt;add missing seed.yaml rows" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#8C959F;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="compose"><mxGeometry x="356" y="288" width="188" height="86" as="geometry"/></mxCell><mxCell id="volumes" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;Volumes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;pgdata: all the data&lt;br&gt;caddy_data: certificates" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fontColor=#57606A;fillColor=#F6F8FA;strokeColor=#8C959F;fontFamily=Helvetica;" vertex="1" parent="compose"><mxGeometry x="356" y="400" width="188" height="86" as="geometry"/></mxCell><mxCell id="sshd" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;sshd · port 22 · user deploy&lt;/font&gt;&lt;/b&gt;&lt;br&gt;GitHub&amp;#x27;s key may only run&lt;br&gt;deploy-gate.sh: no shell, no pty&lt;br&gt;host key pinned in GitHub" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="droplet"><mxGeometry x="592" y="130" width="282" height="86" as="geometry"/></mxCell><mxCell id="sshd-icon-key" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="sshd"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;~/expense-tracker&lt;/font&gt;&lt;/b&gt;&lt;br&gt;.env (chmod 600): DB password, tag&lt;br&gt;deploy-gate.sh → deploy.sh&lt;br&gt;backup.sh&lt;br&gt;compose file + scripts from main" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="droplet"><mxGeometry x="592" y="240" width="282" height="104" as="geometry"/></mxCell><mxCell id="app-icon-folder" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iIzZFNzc4MSIgZD0iTTEwIDRINGMtMS4xIDAtMS45OS45LTEuOTkgMkwyIDE4YzAgMS4xLjkgMiAyIDJoMTZjMS4xIDAgMi0uOSAyLTJWOGMwLTEuMS0uOS0yLTItMmgtOGwtMi0yeiIvPjwvc3ZnPg==;" vertex="1" parent="app"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="cron" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;cron · hourly at :17&lt;/font&gt;&lt;/b&gt;&lt;br&gt;backup.sh auto: one dump a day&lt;br&gt;(when the newest is 23 h old)&lt;br&gt;every deploy takes one first" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="droplet"><mxGeometry x="592" y="368" width="282" height="86" as="geometry"/></mxCell><mxCell id="cron-icon-clock" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="cron"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="backups" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;backups/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;pg_dump, custom format, checked&lt;br&gt;keeps 7 daily + 3 manual&lt;br&gt;copied to Drive, encrypted" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="droplet"><mxGeometry x="592" y="478" width="282" height="86" as="geometry"/></mxCell><mxCell id="backups-icon-storage" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iIzFBN0YzNyIgZD0iTTIgMjBoMjB2LTRIMnY0em0yLTNoMnYySDR2LTJ6TTIgNHY0aDIwVjRIMnptNCAzSDRWNWgydjJ6bS00IDdoMjB2LTRIMnY0em0yLTNoMnYySDR2LTJ6Ii8+PC9zdmc+;" vertex="1" parent="backups"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="github" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#1F2328&quot;&gt;GitHub · personal-finance-workbook&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Actions does the building and starts every deploy" style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;pointerEvents=0;align=left;verticalAlign=top;spacingLeft=50;spacingTop=4;fontSize=12;fontColor=#57606A;fillColor=#F6F8FA;strokeColor=#8C959F;strokeWidth=1.6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="110" width="460" height="466" as="geometry"/></mxCell><mxCell id="github-icon-github" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="github"><mxGeometry x="14" y="12" width="30" height="30" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;Pull request → main&lt;/font&gt;&lt;/b&gt;&lt;br&gt;CI on every PR and on main: make lint, make test&lt;br&gt;a merge alone changes nothing on the server" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="github"><mxGeometry x="16" y="60" width="428" height="70" as="geometry"/></mxCell><mxCell id="repo-icon-github" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="repo"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="images" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;Images workflow · manual, main only&lt;/font&gt;&lt;/b&gt;&lt;br&gt;buildx linux/amd64: backend and frontend&lt;br&gt;tags sha-&amp;lt;commit&amp;gt; and latest&lt;br&gt;also runs inside a deploy when “build” is ticked" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="github"><mxGeometry x="16" y="150" width="428" height="86" as="geometry"/></mxCell><mxCell id="images-icon-githubactions" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="images"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="deploy" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;Deploy workflow · manual, main only&lt;/font&gt;&lt;/b&gt;&lt;br&gt;inputs: tag (sha-&amp;lt;commit&amp;gt;), build&lt;br&gt;checks both images exist on Docker Hub&lt;br&gt;ssh deploy@&amp;lt;server&amp;gt; &amp;quot;deploy sha-&amp;lt;commit&amp;gt;&amp;quot;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="github"><mxGeometry x="16" y="256" width="428" height="86" as="geometry"/></mxCell><mxCell id="deploy-icon-githubactions" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="deploy"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="secrets" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;Actions secrets (names only)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;DOCKERHUB_TOKEN, variable DOCKERHUB_USERNAME&lt;br&gt;DEPLOY_HOST, DEPLOY_USER&lt;br&gt;DEPLOY_SSH_KEY, DEPLOY_KNOWN_HOSTS" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="github"><mxGeometry x="16" y="362" width="428" height="86" as="geometry"/></mxCell><mxCell id="secrets-icon-lock" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="secrets"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;Docker Hub · public image repos&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;lt;dockerhub-user&amp;gt;/expense-tracker-backend&lt;br&gt;&amp;lt;dockerhub-user&amp;gt;/expense-tracker-frontend&lt;br&gt;the server keeps the current and the previous tag" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="612" width="460" height="86" as="geometry"/></mxCell><mxCell id="hub-icon-docker" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="hub"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="drive" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;Google Drive · expense-backups&lt;/font&gt;&lt;/b&gt;&lt;br&gt;rclone crypt: names and contents&lt;br&gt;encrypted; passphrase in Bitwarden&lt;br&gt;keeps 7 daily + 3 manual&lt;br&gt;fetch one: backup.sh fetch &amp;lt;file&amp;gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="962" y="770" width="290" height="104" as="geometry"/></mxCell><mxCell id="drive-icon-googledrive" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="drive"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="drive-icon-rclone" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;" vertex="1" parent="drive"><mxGeometry x="18" y="58" width="24" height="24" as="geometry"/></mxCell><mxCell id="steps" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;One deploy, step by step&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1. Merge the pull request into main. Nothing changes on the server yet.&lt;br&gt;2. Actions › Expense tracker deploy › Run workflow on main, with “build” ticked: the images workflow pushes sha-&amp;lt;commit&amp;gt;.&lt;br&gt;3. The runner checks both images exist, then connects over SSH and sends only: deploy sha-&amp;lt;commit&amp;gt;.&lt;br&gt;4. deploy-gate.sh refreshes the compose file, backup.sh and deploy.sh from main, then runs deploy.sh.&lt;br&gt;5. deploy.sh: backup → pull → IMAGE_TAG in .env → compose up --wait → check nginx and the API → remove older images.&lt;br&gt;Roll back: run the deploy again with the previous tag. If that version ran a migration, restore the backup it took." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="906" height="160" as="geometry"/></mxCell><mxCell id="security" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#1F2328&quot;&gt;Security boundaries&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Public: only Caddy on 80/443. SSH is key-only.&lt;br&gt;frontend binds 127.0.0.1; backend and db aren&amp;#x27;t published.&lt;br&gt;The deploy key can redeploy an existing image, nothing else.&lt;br&gt;The login page is public: 5 wrong tries lock an email 15 min.&lt;br&gt;.env and rclone.conf exist only on the server." style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=56;spacingTop=2;fontSize=12;fontColor=#57606A;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="734" width="460" height="140" as="geometry"/></mxCell><mxCell id="security-icon-shield" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iI0NGMjIyRSIgZD0iTTEyIDFMMyA1djZjMCA1LjU1IDMuODQgMTAuNzQgOSAxMiA1LjE2LTEuMjYgOS02LjQ1IDktMTJWNWwtOS00em0wIDEwLjk5aDdjLS41MyA0LjEyLTMuMjggNy43OS03IDguOTRWMTJINVY2LjNsNy0zLjExdjguOHoiLz48L3N2Zz4=;" vertex="1" parent="security"><mxGeometry x="14" y="16" width="32" height="32" as="geometry"/></mxCell><mxCell id="e-dns" style="edgeStyle=none;rounded=1;html=1;strokeColor=#6E7781;strokeWidth=1.8;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;dashPattern=7 5;" edge="1" parent="1" source="browser" target="dns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-req" style="edgeStyle=none;rounded=1;html=1;strokeColor=#1F6FEB;strokeWidth=1.8;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;exitX=1.0;exitY=0.3488;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.3488;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="browser" target="caddy"><mxGeometry relative="1" as="g